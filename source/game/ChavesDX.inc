{ ChavesDX.inc - cria as listas de imagens e a tela do jogo e carrega as imagens embutidas
  (source/Embutidos). Os sons ficam em SomEfeitos/SomMusica/SomVitoria (ChavesSom). }

procedure AddImagem(L: TListaImagens; const N, F: string; Transp: Boolean; TC: TColor; PW, PH: Integer);
begin
  L.Adicionar.CarregarArquivo(F, Transp, TC, PW, PH);
end;

