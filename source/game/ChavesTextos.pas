procedure Preencher(Dest: TStrings; const Fonte: array of string);
var
  I: Integer;
begin
  Dest.BeginUpdate;
  try
    Dest.Clear;
    for I := Low(Fonte) to High(Fonte) do
      Dest.Add(Fonte[I]);
  finally
    Dest.EndUpdate;
  end;
end;

procedure CarregarTextos(Idioma: Integer; Nomes, Texto, Config, Frases, Dialogo,
  Finais, Cenarios: TStrings);
begin
  if Idioma = 1 then
  begin
    Preencher(Nomes, TNomesPT);
    Preencher(Texto, TTextoPT);
    Preencher(Config, TConfigPT);
    Preencher(Frases, TFrasesPT);
    Preencher(Dialogo, TDialogoPT);
    Preencher(Finais, TFinaisPT);
    Preencher(Cenarios, TCenariosPT);
  end
  else
  begin
    Preencher(Nomes, TNomesES);
    Preencher(Texto, TTextoES);
    Preencher(Config, TConfigES);
    Preencher(Frases, TFrasesES);
    Preencher(Dialogo, TDialogoES);
    Preencher(Finais, TFinaisES);
    Preencher(Cenarios, TCenariosES);
  end;
end;

