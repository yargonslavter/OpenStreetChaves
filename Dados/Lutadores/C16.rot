; Dados/Lutadores/C16.rot - roteiro do personagem 16 (Chapolin).
;   [Acao]  parte de AcaoJogador so deste personagem (os golpes especiais e suas condicoes),
;           executada depois do [Acao] de Comum.rot.
;   [Quadro] parte de AtualizaQuadro so deste personagem (a animacao e os efeitos de cada golpe),
;           executada depois do [Quadro] de Comum.rot.
;   [IA]     quando o computador usa cada golpe especial deste personagem (depois do [IA] de
;           Comum.rot). A sintaxe e as entradas estao explicadas em Comum.rot.
;   [Acerto] quando um golpe deste personagem acerta o oponente (combo, giro, recuo, lancamento,
;           golpes encadeados).
; Especiais: 1 Corneta Paralisadora (onda que deixa o oponente parado, efeito 37),
; 2 Marreta Bionica, 3 Chipote Voador (sobe girando a marreta), 4 Pilulas de Nanicolina (encolhe,
; passa por baixo dos golpes altos e volta com um gancho), final "Sigam-me os bons!" (salta e cai
; com a marreta, efeito 38). Sons novos: 67 = guincho da marreta (Som-68), 68 = corneta (Som-69).

[Acao]
if (Codigo = cmVitoria) and (P.Acao in [acParado, acAndando, acAgachado]) then
begin
  P.Acao := acVitoria;
  P.QuadroAcao := 0;
  P.DuracaoAcao := 250;
end;
if (Codigo = cmPose) and (P.Acao in [acParado, acAndando]) then
begin
  P.Acao := acPose;
  P.QuadroAcao := 0;
  P.DuracaoAcao := 20;
end;
if (Codigo in [cmEsp1Fraco, cmEsp1Forte]) and (P.Acao in [acParado, acAndando, acDefesa, acDefesaBaixa]) and
   not ExisteEfeito(37, Jog) then
begin
  P.Acao := acEspecial1;
  P.QuadroAcao := 0;
  P.DuracaoAcao := 30;
  if P.CargaPoder < CargaMax then P.CargaPoder := 5 * GanhoCarga + P.CargaPoder;
  if Codigo = cmEsp1Fraco then P.ForcaGolpe := fgFraco;
  if Codigo = cmEsp1Forte then P.ForcaGolpe := fgForte;
end;
if (Codigo in [cmEsp2Fraco, cmEsp2Forte]) and (P.Acao in [acParado, acAndando, acDefesa, acDefesaBaixa]) then
begin
  P.Acao := acEspecial2;
  P.QuadroAcao := 0;
  if P.CargaPoder < CargaMax then P.CargaPoder := 5 * GanhoCarga + P.CargaPoder;
  if Codigo = cmEsp2Fraco then P.DuracaoAcao := 16;
  if Codigo = cmEsp2Forte then P.DuracaoAcao := 24;
  if Codigo = cmEsp2Fraco then P.ForcaGolpe := fgFraco;
  if Codigo = cmEsp2Forte then P.ForcaGolpe := fgForte;
end;
if (Codigo in [cmEsp3Fraco, cmEsp3Forte]) and (P.Acao in [acParado, acAndando, acPulo, acDefesaBaixa, acEspecial2]) then
  if ChaoY - 90 <= P.Y then
  begin
    P.Acao := acEspecial3;
    if P.CargaPoder < CargaMax then P.CargaPoder := 6 * GanhoCarga + P.CargaPoder;
    P.Y := ChaoY;
    P.NoAr := False;
    P.QuadroAcao := 0;
    P.VelY := 0;
    P.DirPulo := puloNenhum;
    P.TempoBaixo := 0;
    P.SeqEstado := 0;
    if Codigo = cmEsp3Fraco then P.DuracaoAcao := 10;
    if Codigo = cmEsp3Forte then P.DuracaoAcao := 16;
    if Codigo = cmEsp3Fraco then P.ForcaGolpe := fgFraco;
    if Codigo = cmEsp3Forte then P.ForcaGolpe := fgForte;
  end;
if (Codigo in [cmEsp4Fraco, cmEsp4Forte]) and (P.Acao in [acParado, acAndando, acDefesa, acDefesaBaixa]) then
begin
  P.Acao := acEspecial4;
  P.QuadroAcao := 0;
  if P.CargaPoder < CargaMax then P.CargaPoder := 5 * GanhoCarga + P.CargaPoder;
  P.DuracaoAcao := 34;
  if Codigo = cmEsp4Fraco then P.ForcaGolpe := fgFraco;
  if Codigo = cmEsp4Forte then P.ForcaGolpe := fgForte;
end;
if (Codigo = cmEspFinal) and
   (P.Acao in [acParado, acAndando, acSocoForte, acAgachado, acDefesa, acDefesaBaixa]) and
   ((P.Vida <= 15) or (P.Poder > 0)) then
begin
  P.Acao := acEspecial5;
  P.QuadroAcao := 0;
  P.DuracaoAcao := 38;
  if P.Poder = 3 then P.CargaPoder := 0;
  P.Poder := P.Poder - 1;
  P.Quadro := Desloc + 49;
  P.ForcaGolpe := fgEspecial;
  FlashTela := 22;
  SomPendente := sndEspFinal;
end;

[Quadro]
var Cont, Sentido: Integer;

Sentido := 1;
if P.Lado = ldEsquerda then Sentido := -1;
if P.Acao = acVitoria then
begin
  if P.QuadroAcao = 0 then P.Quadro := Desloc + 33;
  if P.QuadroAcao = 8 then P.Quadro := Desloc + 34;
  if P.QuadroAcao = 16 then P.Quadro := Desloc + 35;
  if P.QuadroAcao = 24 then P.Quadro := Desloc + 34;
  if P.QuadroAcao = 32 then P.Quadro := Desloc + 33;
  if P.QuadroAcao = 32 then P.QuadroAcao := 0;
end;
if (P.Acao = acPose) and (P.QuadroAcao = 0) then P.Quadro := Desloc + 12;
if (P.Acao = acPose) and (P.QuadroAcao = 2) then P.Quadro := Desloc + 30;
{ corneta paralisadora: leva a corneta a boca e sopra; a onda sai no quadro 10 }
if P.Acao = acEspecial1 then
begin
  if P.QuadroAcao = 0 then P.Quadro := Desloc + 36;
  if P.QuadroAcao = 4 then P.Quadro := Desloc + 37;
  if P.QuadroAcao = 8 then SomPendente := 68;
  if P.QuadroAcao >= 8 then
  begin
    if (P.QuadroAcao div 3) mod 2 = 0 then P.Quadro := Desloc + 38 else P.Quadro := Desloc + 39;
  end;
  if P.QuadroAcao = 10 then
  begin
    if P.ForcaGolpe = fgFraco then CriaEfeito(37, 'A', Jog, P.X + 50 * Sentido, P.Y - 85);
    if P.ForcaGolpe = fgForte then CriaEfeito(37, 'B', Jog, P.X + 50 * Sentido, P.Y - 85);
  end;
end;
{ a onda acertou: o oponente fica parado (tremendo) enquanto ela existir }
if ExisteEfeito(37, Jog) and (O.Acao in [acApanhaAlto, acApanhaBaixo]) then
begin
  O.QuadroAcao := 0;
  if Random(4) = 0 then CriaEfeito(1, '', 0, O.X + Random(40) - 20, O.Y - 40 - Random(90));
end;
{ marreta bionica: ergue, gira e bate (o forte avanca) }
if P.Acao = acEspecial2 then
begin
  if P.QuadroAcao = 0 then SomPendente := sndGolpeForte;
  if P.QuadroAcao = 0 then P.Quadro := Desloc + 40;
  if (P.QuadroAcao = 4) and (P.ForcaGolpe = fgFraco) then P.Quadro := Desloc + 41;
  if (P.QuadroAcao = 6) and (P.ForcaGolpe = fgForte) then P.Quadro := Desloc + 41;
  if ((P.QuadroAcao = 7) and (P.ForcaGolpe = fgFraco)) or ((P.QuadroAcao = 10) and (P.ForcaGolpe = fgForte)) then
  begin
    P.Quadro := Desloc + 42;
    SomPendente := 67;
    for Cont := 1 to 3 do CriaEfeito(2, '', 0, P.X + 60 * Sentido + Random(30) - 15, P.Y - Random(6));
  end;
  if (P.ForcaGolpe = fgForte) and (P.QuadroAcao < 10) then Empurra(Jog, 6 * Sentido);
end;
{ chipote voador: sobe girando a marreta }
if P.Acao = acEspecial3 then
begin
  if P.Acertos >= 1 then O.Invulneravel := False;
  if P.Acertos >= 4 then O.Invulneravel := True;
  if P.QuadroAcao > 7 then O.Invulneravel := True;
  if P.QuadroAcao = 0 then SomPendente := 67;
  if P.QuadroAcao mod 3 = 0 then
  begin
    if P.Quadro = Desloc + 43 then P.Quadro := Desloc + 44
    else P.Quadro := Desloc + 43;
  end;
  P.Y := P.Y - 10;
  Empurra(Jog, 5 * Sentido);
  if P.QuadroAcao = 20 then P.NoAr := True;
  P.EhChute := True;
end;
{ pilulas de nanicolina: engole, corre pequenininho e cresce com um gancho }
if P.Acao = acEspecial4 then
begin
  if P.QuadroAcao = 0 then SomPendente := sndItem;
  if P.QuadroAcao = 0 then P.Quadro := Desloc + 45;
  if (P.QuadroAcao >= 6) and (P.QuadroAcao < 24) then
  begin
    if (P.QuadroAcao div 3) mod 2 = 0 then P.Quadro := Desloc + 46 else P.Quadro := Desloc + 47;
    if P.ForcaGolpe = fgFraco then Empurra(Jog, 9 * Sentido);
    if P.ForcaGolpe = fgForte then Empurra(Jog, 12 * Sentido);
  end;
  if P.QuadroAcao = 24 then
  begin
    P.Quadro := Desloc + 48;
    SomPendente := sndGolpeForte;
    CriaEfeito(2, '', 0, P.X, P.Y);
  end;
end;
{ especial final: "Sigam-me os bons!", salta e cai com a marreta (PLAFT!); ninguem o
  interrompe ate a batida }
if P.Acao = acEspecial5 then
begin
  if P.QuadroAcao <= 16 then P.Invulneravel := True else P.Invulneravel := False;
  if P.QuadroAcao = 0 then P.Quadro := Desloc + 49;
  if (P.QuadroAcao >= 8) and (P.QuadroAcao < 16) then
  begin
    P.Quadro := Desloc + 50;
    Empurra(Jog, 10 * Sentido);
  end;
  if P.QuadroAcao = 16 then
  begin
    P.Quadro := Desloc + 42;
    SomPendente := 67;
    CriaEfeito(38, 'A', Jog, P.X + 75 * Sentido, P.Y);
    TremorTela := 20;
    for Cont := 1 to 4 do CriaEfeito(2, '', 0, P.X + 75 * Sentido + Random(60) - 30, P.Y - Random(6));
  end;
end;

[IA]
{ mais agressivo que os outros: usa os especiais com mais frequencia (fatores menores) }
if not P.Defendendo then
begin
  if (Ameaca = 1) and (DistProj > 140) then
    if Random(Round(5 * Fator)) = 0 then AcaoJogador(Jog, Random(2) + cmEsp1Fraco);
  if (Ameaca = 1) and (DistProj <= 140) and (DistProj > 60) then
    if Random(Round(6 * Fator)) = 0 then AcaoJogador(Jog, Random(2) + cmEsp4Fraco);
  if (Ameaca = 0) and (Dist > 140) then
    if Random(Round(20 * Fator)) = 0 then AcaoJogador(Jog, Random(2) + cmEsp1Fraco);
  if (Ameaca = 0) and (Dist < 130) then
    if Random(Round(22 * Fator)) = 0 then AcaoJogador(Jog, Random(2) + cmEsp2Fraco);
  if (Dist < 150) and (ChaoY > O.Y) then
    if Random(Round(30 * Fator)) = 0 then AcaoJogador(Jog, Random(2) + cmEsp3Fraco);
  if (Ameaca = 0) and (Dist > 100) and (Dist < 260) and (Random(Round(30 * Fator)) = 0) then
    AcaoJogador(Jog, Random(2) + cmEsp4Fraco);
  if (Dist < 220) and (Random(Round(35 * Fator)) = 0) then AcaoJogador(Jog, cmEspFinal);
  { oponente paralisado pela corneta: aproveita com a marreta }
  if ExisteEfeito(37, Jog) and (O.Acao in [acApanhaAlto, acApanhaBaixo]) and (Dist < 120) then
    if Random(3) = 0 then AcaoJogador(Jog, cmEsp2Forte);
end;

[Acerto]
// quando um golpe deste personagem acerta (depois do dano, da reacao e do recuo padrao do oponente):
// tempo do combo, giro, recuo e lancamento do oponente, e golpes que continuam em outra acao.
if (P.Acao = acEspecial2) and (P.ForcaGolpe = fgForte) then O.Recuo := 20;
if P.Acao = acEspecial4 then O.Recuo := 15;
